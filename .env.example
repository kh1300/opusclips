APP_NAME=ClipForge API
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/clipforge
REDIS_URL=redis://redis:6379/0
AUTO_CREATE_TABLES=true

REQUIRE_AUTH=false
SUPABASE_URL=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_CLIP_MODEL=gpt-4o-mini
MOCK_AI=false

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

MAX_UPLOAD_SIZE_MB=2048
WORK_DIR=/app/work
LOCAL_SAMPLE_VIDEO_DIR=/app/samples
CLIPS_PER_VIDEO_MIN=5
CLIPS_PER_VIDEO_MAX=10
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=60
FFMPEG_THREADS=2
YT_DLP_FORMAT=bv*+ba/b

NEXT_PUBLIC_API_URL=http://localhost:8000/api
